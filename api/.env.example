# Copy to api/.env. Nothing here should ever be committed with real values.

# Your teacher login, created the first time the API starts.
TEACHER_NAME=Felipe Bezerra
TEACHER_EMAIL=
TEACHER_PASSWORD=

# PostgreSQL connection link from your provider (Neon, Supabase...).
# Left empty in development, the API uses a local database in api/.data.
DATABASE_URL=

# Mercado Pago private access token. Left empty in development, checkout is simulated.
MP_ACCESS_TOKEN=

# Google OAuth client, to pick lesson videos from your YouTube channel (see README).
# Left empty, you paste video links by hand.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public addresses in production, so payments can return here and notify the API.
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
